# Canonical host (PRD §1). southeastroofing.llc is the primary production
# domain; roofs.ms redirects to it. Never hardcode a domain in code.
NEXT_PUBLIC_SITE_URL=https://southeastroofing.llc

# Google Search Console verification token (the "content" value from the
# HTML-tag verification method). Emits <meta name="google-site-verification">
# when set. Leave blank until you verify the property in Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (the "content" value from its
# HTML-meta option, name="msvalidate.01"). Only needed if you DON'T use Bing's
# one-click "Import from Google Search Console". Leave blank otherwise.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key — instant "please crawl this" pings to Bing/Yandex/DuckDuckGo
# (Google ignores IndexNow). A default key + its /public key file are committed;
# only set this to rotate to a new key (also rename the key file in /public).
INDEXNOW_KEY=

# Secret that guards the weekly GBP auto-post cron (/api/cron/gbp-weekly, run by
# Vercel Cron per vercel.json). When set, the route requires Vercel's
# "Authorization: Bearer <CRON_SECRET>" header. Recommended in production.
CRON_SECRET=

# Sanity CMS — create a free project at sanity.io (see docs/DEPLOYMENT.md),
# then paste the project ID here. The studio at /studio activates once set.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Lead pipeline (see docs/DEPLOYMENT.md §3) ────────────────────────────
# Webhook that receives every form lead as JSON. Point it at a Make.com
# scenario (free tier), a Zapier catch hook, or a Roofr intake endpoint.
LEAD_WEBHOOK_URL=

# Optional email notification for every lead, sent via Resend (free tier).
# LEAD_NOTIFY_EMAIL defaults to the office address in siteConfig.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=

# The Zapier Email Parser mailbox that creates the Roofr job, e.g.
# something@robot.zapier.com. ONLY instant-estimate leads are sent here, so
# Roofr stays a pipeline of people who asked for a price instead of a copy of
# every form on the site. Leave blank and nothing is routed separately.
#
# This lives here rather than in a Zapier Filter step because Filter is a paid
# Zapier feature: adding it disabled the whole Zap when the trial ended, and
# leads stopped reaching Roofr entirely. An address in this variable is also
# removed from LEAD_NOTIFY_EMAIL automatically, so the two cannot disagree.
LEAD_ROOFR_EMAIL=

# Optional "pick a time" button on the form thank-you screen — paste a free
# Google Calendar appointment-schedule link (or Cal.com link).
NEXT_PUBLIC_BOOKING_URL=

# ── Job upload tool at /upload (see the job-relay system) ────────────────
# SECRET. Sanity Editor token (sanity.io → API → Tokens). Lets the /upload
# form save jobs into the gallery. Server-only — never NEXT_PUBLIC.
SANITY_WRITE_TOKEN=
# Passphrase that gates the /upload page. Defaults to "roofroof" if unset.
UPLOAD_PASSWORD=

# ── Production dashboard at /production (internal job tracker) ───────────
# Password for the /production login screen. Falls back to UPLOAD_PASSWORD,
# then to the same built-in default as /upload, so by default one team
# password opens both tools. Server-side only — never NEXT_PUBLIC.
PRODUCTION_PASSWORD=
# OPTIONAL but recommended. Key that encrypts production-tracker customer
# data before it is stored (the Sanity dataset is public-read, so payloads
# are sealed with AES-256-GCM). Any long random string. If unset, a key is
# derived from SANITY_WRITE_TOKEN — which means rotating that token would
# make existing tracker data unreadable. Set this once and never change it.
PRODUCTION_DATA_KEY=
# Dev/testing ONLY: store tracker data in process memory instead of Sanity
# (no token needed, data lost on restart). Never set in production.
PRODUCTION_TEST_MEMORY_STORE=

# ── Social syndication (optional, added per platform as they're connected).
# With none set, uploads still fully post to the website; socials are skipped.
META_PAGE_ACCESS_TOKEN=
GOOGLE_BUSINESS_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
NEXTDOOR_ACCESS_TOKEN=

# ── Metricool (Google Business Profile + TikTok fan-out) ─────────────────
# The networks Meta's Graph API can't reach go through Metricool. All three
# SECRET/ids are required together; with none set the fan-out is a safe no-op.
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
# Set to 1 to ALSO auto-post each new job's finished-work photos to the GBP
# *Photos gallery* (a separate surface from the Posts feed). Leave blank until
# a single test post via POST /api/upload?step=gbp-photo confirms photos land
# in the gallery — see src/lib/metricool.ts (GBP_DATA_FIELD / GBP_PHOTO_TYPE).
METRICOOL_GBP_PHOTOS=

# ── Google Business Profile API (Tier 1, official) ───────────────────────
# Direct first-party posting to the GBP Photos gallery + "Updates" feed.
# Full setup: docs/GBP-API-SETUP.md. All SECRET; server-only, never NEXT_PUBLIC.
# With none set, uploads still fully post to the website + other socials.
#
# OAuth client (Google Cloud console → APIs & Services → Credentials):
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
# Long-lived refresh token from the one-time owner consent. Get it with
# POST /api/upload?step=gbp-auth (returns the consent URL, then exchanges the
# code). See docs/GBP-API-SETUP.md.
GBP_REFRESH_TOKEN=
# The account + location the job photos belong to. Discover both with
# POST /api/upload?step=gbp (lists accounts, then locations). Number or the
# full "accounts/123" / "locations/456" resource name — either works.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
