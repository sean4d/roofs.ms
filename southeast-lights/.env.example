# Canonical host. Set to the Vercel preview URL during development and to
# https://southeastlights.llc only at launch. Never hardcode a domain in code.
NEXT_PUBLIC_SITE_URL=https://southeastlights.llc

# ── Analytics ────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics is skipped
# entirely when this is unset, so previews never pollute production data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (the "content" value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Lead delivery ────────────────────────────────────────────────────────
# Leads fan out to every configured channel and succeed if ANY accepts them.
# With none set, the form returns an honest error telling the customer to
# call, rather than silently swallowing the lead.
#
# 1. Roofr CRM. NOT CONNECTED. Roofr does not publish a public lead-intake
#    API, so point this at a Roofr-supplied webhook, or at a Make.com /
#    Zapier hook that creates the Roofr lead.
ROOFR_WEBHOOK_URL=
# Optional bearer token sent with the Roofr request.
ROOFR_API_KEY=
#
# 2. Email notification via Resend (free tier is enough for this volume).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
#
# 3. Generic webhook fallback (Make.com, Zapier, n8n).
LEAD_WEBHOOK_URL=

# ── Project gallery ──────────────────────────────────────────────────────
# Demo gallery projects render by default with a visible "Demo content" badge
# and noindex, so the site looks finished during review. Set to 1 to remove
# them entirely once real Southeast Lights photography is in place.
NEXT_PUBLIC_HIDE_DEMO_PROJECTS=

# ── Season preview ───────────────────────────────────────────────────────
# ?season=holiday and ?season=offseason preview either personality. Honoured
# on local dev and Vercel PREVIEW deployments; automatically off on the
# production deployment. Set to 1 to force it off anywhere.
NEXT_PUBLIC_DISABLE_SEASON_PREVIEW=

# ── Google reviews (optional) ────────────────────────────────────────────
# With a Places API key the review count and rating can be pulled live
# instead of being maintained by hand in config/reviews.ts.
GOOGLE_PLACES_API_KEY=
